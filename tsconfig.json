{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@functions/*": ["functions/*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "functions/**/*", "astro.config.mjs"],
  "exclude": ["dist", ".astro", "node_modules"]
}
