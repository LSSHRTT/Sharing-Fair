{
  "name": "sharing-fair",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "db:migrate:local": "wrangler d1 migrations apply sharing_fair_db --local",
    "db:migrate:prod": "wrangler d1 migrations apply sharing_fair_db --remote",
    "db:seed:local": "wrangler d1 execute sharing_fair_db --local --file=migrations/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "hono": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
