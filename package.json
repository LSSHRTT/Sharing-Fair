{
  "name": "sharing-fair",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "icons:generate": "node scripts/generate-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply sharing_fair_db --local",
    "db:migrate:prod": "wrangler d1 migrations apply sharing_fair_db --remote",
    "db:seed:local": "wrangler d1 execute sharing_fair_db --local --file=scripts/seed.sql",
    "events:seed:local": "wrangler d1 execute sharing_fair_db --local --file=scripts/events-ordre-du-jour.sql",
    "events:seed:prod": "wrangler d1 execute sharing_fair_db --remote --file=scripts/events-ordre-du-jour.sql",
    "benevole:add": "node scripts/add-volunteer.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "hono": "^4.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "wrangler": "^4.105.0"
  }
}
