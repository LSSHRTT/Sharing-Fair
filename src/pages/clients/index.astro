---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Pagination from '../../components/ui/Pagination.astro';
import Icon from '../../components/ui/Icon.astro';
import ClientCard from '../../components/clients/ClientCard.astro';
import { fullName } from '../../lib/format';
import { listClients } from '../../../functions/api/lib/db';

const DB = Astro.locals.runtime.env.DB;

const q = Astro.url.searchParams.get('q')?.trim() || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const pageSize = 24;

const result = await listClients(DB, { q, tag: '', page, pageSize });
const { items: clients, total, totalPages } = result;

// Tous les destinataires de la base (nom + email, dédupliqués par email) —
// même filtre de recherche que la page, pour que "Tout sélectionner"
// fonctionne au-delà de la pagination.
const allClientsResult = total > 0
  ? await listClients(DB, { q, tag: '', page: 1, pageSize: total })
  : { items: [] };
const seenEmails = new Set<string>();
const allRecipients: { email: string; name: string }[] = [];
for (const c of allClientsResult.items) {
  const email = c.email?.trim().toLowerCase();
  if (!email || seenEmails.has(email)) continue;
  seenEmails.add(email);
  allRecipients.push({ email, name: fullName(c) });
}
---

<Layout title={`Clients — Sharing Fair`}>
  <div class="space-y-6">
    <PageHeader title="Clients">
      <span slot="actions" class="text-sm text-ink-500 self-center">
        <strong class="font-display text-lg text-ink-900">{total}</strong> {total > 1 ? 'fiches' : 'fiche'}
      </span>
      <Button slot="actions" variant="secondary" id="open-email-modal">
        <Icon name="mail" size={16} />
        Envoyer un mail
      </Button>
      <Button slot="actions" href="/clients/nouveau" variant="primary">
        <Icon name="plus" size={16} />
        Nouveau client
      </Button>
    </PageHeader>

    <!-- Modale d'envoi groupé -->
    <div id="email-modal" class="fixed inset-0 z-[1000] hidden" role="dialog" aria-modal="true">
      <div class="fixed inset-0 bg-ink-900/40 backdrop-blur-sm" data-modal-close></div>
      <div class="fixed inset-0 overflow-y-auto">
        <div class="flex min-h-full items-end sm:items-center justify-center p-4">
          <div class="relative bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6">
            <div class="space-y-4">
              <div>
                <h3 class="text-xl font-semibold text-ink-900 font-display">Envoyer un mail groupé</h3>
                <p class="text-sm text-ink-600 mt-2 leading-relaxed">
                  Sélectionnez les destinataires, puis ouvrez Roundcube : un nouveau message sera créé avec les adresses en copie cachée (Cci).
                </p>
              </div>

              <div class="flex items-center gap-2 flex-wrap">
                <Button type="button" variant="outline" size="sm" id="modal-select-page">
                  Sélectionner la page
                </Button>
                <Button type="button" variant="outline" size="sm" id="modal-select-all">
                  Tout sélectionner
                </Button>
                <Button type="button" variant="ghost" size="sm" id="modal-select-none">
                  Effacer
                </Button>
                <span id="modal-count" class="text-sm text-ink-500 ml-auto"></span>
              </div>

              <!-- Pastilles des destinataires -->
              <div id="recipient-chips" class="max-h-40 overflow-y-auto rounded-lg border border-ink-200 bg-ink-50 p-2 flex flex-wrap gap-1.5 content-start">
                <p id="chips-empty" class="text-xs text-ink-400 p-2 w-full">
                  Aucun destinataire — cochez des clients sur la page ou utilisez les boutons ci-dessus.
                </p>
              </div>

              <!-- Objet + message -->
              <div class="space-y-2">
                <input
                  type="text"
                  id="mail-subject"
                  placeholder="Objet du mail (optionnel)"
                  class="w-full h-10 px-3 rounded-lg border border-ink-200 bg-white text-sm text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
                />
                <textarea
                  id="mail-body"
                  rows="3"
                  placeholder="Message (optionnel) — pré-rempli dans Roundcube si court, sinon copié dans le presse-papier."
                  class="w-full rounded-lg border border-ink-200 bg-white p-3 text-sm text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
                ></textarea>
              </div>

              <p id="mail-status" class="text-sm font-medium hidden"></p>

              <div class="flex items-center gap-2 pt-2">
                <Button type="button" variant="ghost" id="modal-close-btn">Fermer</Button>
                <Button type="button" variant="outline" id="copy-emails">
                  <Icon name="check" size={14} />
                  Copier les adresses
                </Button>
                <Button type="button" variant="primary" id="open-roundcube" class="flex-1">
                  <Icon name="mail" size={16} />
                  Ouvrir Roundcube
                </Button>
              </div>
              <p class="text-xs text-ink-400">
                💡 Connectez-vous d'abord à Roundcube dans un autre onglet pour que la composition s'ouvre directement.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tous les destinataires de la base (pour "Tout sélectionner") -->
    <script type="application/json" id="all-emails-data" set:html={JSON.stringify(allRecipients).replace(/</g, '\\u003c')}></script>
    <form method="GET" action="/clients" class="surface p-3 sm:p-4">
      <div class="flex gap-2">
        <div class="flex-1 relative">
          <Icon name="search" size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-400 pointer-events-none" />
          <Input
            type="search"
            name="q"
            value={q}
            placeholder="Rechercher par nom, prénom, email, téléphone…"
            iconLeft
            class="w-full"
          />
        </div>
        <Button type="submit" variant="secondary">
          <Icon name="filter" size={16} />
          <span class="hidden sm:inline">Rechercher</span>
        </Button>
        {q && (
          <Button href="/clients" variant="ghost">
            <Icon name="x" size={16} />
            <span class="sr-only">Réinitialiser</span>
          </Button>
        )}
      </div>
      {q && (
        <p class="text-xs text-ink-500 mt-3">
          {total} résultat{total > 1 ? 's' : ''} pour <strong class="text-ink-900">"{q}"</strong>
        </p>
      )}
    </form>

    <!-- Results -->
    {clients.length === 0 ? (
      <EmptyState
        title={q ? 'Aucun résultat' : 'Aucun client pour l\'instant'}
        description={q
          ? `Aucune fiche ne correspond à "${q}". Essayez un autre terme.`
          : 'Créez votre première fiche client pour commencer.'}
      >
        <Icon slot="icon" name="users" size={24} />
        {!q && (
          <Button slot="actions" href="/clients/nouveau" variant="primary">
            <Icon name="plus" size={16} />
            Créer le premier client
          </Button>
        )}
        {q && (
          <Button slot="actions" href="/clients" variant="outline">
            Réinitialiser
          </Button>
        )}
      </EmptyState>
    ) : (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" data-stagger>
          {clients.map((client) => <ClientCard client={client} />)}
        </div>

        <Pagination
          page={page}
          totalPages={totalPages}
          baseUrl="/clients"
          searchParams={q ? { q } : {}}
        />

        <!-- Barre flottante de sélection -->
        <div
          id="selection-bar"
          class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 items-center gap-3 bg-ink-900 text-white pl-5 pr-2 py-2 rounded-full shadow-2xl"
        >
          <span class="text-sm">
            <strong id="sel-count" class="font-display text-base">0</strong> client(s) sélectionné(s)
          </span>
          <Button type="button" variant="primary" size="sm" id="toolbar-open-modal">
            <Icon name="mail" size={14} />
            Préparer le mail
          </Button>
          <button
            type="button"
            id="toolbar-clear"
            class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
            aria-label="Tout désélectionner"
          >
            <Icon name="x" size={14} />
          </button>
        </div>
      </>
    )}
  </div>

  <script is:inline>
// Logique d'envoi groupé de mails — sélection de clients → regroupement des
// adresses → ouverture de Roundcube avec les destinataires en Cci.

// ============================================================
// Configuration — adaptez si votre webmail OVH a une autre URL
// ============================================================
const ROUNDCUBE_BASE = 'https://webmail.mail.ovh.net/';
const BCC_LIMIT = 40;   // adresses max pré-remplies dans l'URL Roundcube (le reste passe par la copie)
const BODY_LIMIT = 300; // corps de message max pré-rempli dans l'URL (sinon → presse-papier)
const STORAGE_KEY = 'sf-mail-selection';

// ============================================================
// Éléments du DOM
// ============================================================
const modal = document.getElementById('email-modal');
const chipsContainer = document.getElementById('recipient-chips');
const chipsEmpty = document.getElementById('chips-empty');
const selCount = document.getElementById('sel-count');
const modalCount = document.getElementById('modal-count');
const statusEl = document.getElementById('mail-status');
const selectionBar = document.getElementById('selection-bar');
const subjectInput = document.getElementById('mail-subject');
const bodyInput = document.getElementById('mail-body');

const allRecipients = JSON.parse(document.getElementById('all-emails-data').textContent);
const namesByEmail = new Map(allRecipients.map(r => [r.email, r.name]));

// ============================================================
// État — la sélection vit dans `selected` (email → nom) et est
// persistée en session (survit aux changements de page/recherche).
// ============================================================
const selected = new Map();

try {
  const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
  if (Array.isArray(saved)) {
    for (const r of saved) {
      if (r && typeof r.email === 'string') selected.set(r.email, r.name || r.email);
    }
  }
} catch { /* sessionStorage indisponible : on continue sans persistance */ }

function saveSelection() {
  try {
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify([...selected.entries()].map(([email, name]) => ({ email, name }))));
  } catch { /* non bloquant */ }
}

function selectedEmails() {
  return [...selected.keys()];
}

function pageEmails() {
  return Array.from(document.querySelectorAll('[data-email-checkbox]')).map(cb => cb.value);
}

// Synchronise les cases cochées de la page avec l'état
function syncCheckboxes() {
  document.querySelectorAll('[data-email-checkbox]').forEach(cb => {
    cb.checked = selected.has(cb.value);
  });
}

// ============================================================
// UI helpers
// ============================================================
function updateFooterBar() {
  const n = selected.size;
  selCount.textContent = n;
  selectionBar.classList.toggle('hidden', n === 0);
  selectionBar.classList.toggle('flex', n > 0);
}

function renderChips() {
  chipsContainer.querySelectorAll('[data-chip]').forEach(el => el.remove());
  const entries = [...selected.entries()].sort((a, b) => a[1].localeCompare(b[1], 'fr'));

  chipsEmpty.classList.toggle('hidden', entries.length > 0);

  for (const [email, name] of entries) {
    const chip = document.createElement('span');
    chip.setAttribute('data-chip', '');
    chip.className = 'inline-flex items-center gap-1 pl-2.5 pr-1 py-1 rounded-full bg-white border border-ink-200 text-xs text-ink-700 shadow-xs';

    const label = document.createElement('span');
    label.className = 'truncate max-w-[180px]';
    label.textContent = name !== email ? `${name} · ${email}` : email;
    label.title = email;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'w-5 h-5 flex items-center justify-center rounded-full text-ink-400 hover:text-danger-600 hover:bg-danger-50 transition-colors';
    btn.textContent = '✕';
    btn.setAttribute('aria-label', `Retirer ${name}`);
    btn.addEventListener('click', () => {
      selected.delete(email);
      saveSelection();
      syncCheckboxes();
      refreshUI();
    });

    chip.appendChild(label);
    chip.appendChild(btn);
    chipsContainer.appendChild(chip);
  }
}

function refreshUI() {
  const n = selected.size;
  modalCount.textContent = n + (n > 1 ? ' destinataires' : ' destinataire');
  statusEl.classList.add('hidden');
  renderChips();
  updateFooterBar();
}

function showStatus(message, ok) {
  statusEl.textContent = message;
  statusEl.className = 'text-sm font-medium ' + (ok ? 'text-success-600' : 'text-danger-600');
}

function openModal() {
  refreshUI();
  modal.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  modal.classList.add('hidden');
  document.body.style.overflow = '';
}

// ============================================================
// Événements
// ============================================================
document.getElementById('open-email-modal').addEventListener('click', openModal);
document.getElementById('toolbar-open-modal').addEventListener('click', openModal);
document.getElementById('modal-close-btn').addEventListener('click', closeModal);

document.getElementById('toolbar-clear').addEventListener('click', () => {
  selected.clear();
  saveSelection();
  syncCheckboxes();
  refreshUI();
});

modal.querySelectorAll('[data-modal-close]').forEach(el => el.addEventListener('click', closeModal));

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
});

// Clic sur une case d'une carte client → met à jour la sélection
document.addEventListener('change', (e) => {
  if (e.target.matches('[data-email-checkbox]')) {
    if (e.target.checked) {
      selected.set(e.target.value, e.target.dataset.name || namesByEmail.get(e.target.value) || e.target.value);
    } else {
      selected.delete(e.target.value);
    }
    saveSelection();
    refreshUI();
  }
});

// « Sélectionner la page » : coche uniquement les clients visibles
document.getElementById('modal-select-page').addEventListener('click', () => {
  document.querySelectorAll('[data-email-checkbox]').forEach(cb => {
    selected.set(cb.value, cb.dataset.name || cb.value);
  });
  saveSelection();
  syncCheckboxes();
  refreshUI();
});

// « Tout sélectionner » : TOUS les emails de la base (au-delà de la page affichée)
document.getElementById('modal-select-all').addEventListener('click', () => {
  allRecipients.forEach(r => selected.set(r.email, r.name));
  saveSelection();
  syncCheckboxes();
  refreshUI();
});

// « Effacer » : vide toute la sélection
document.getElementById('modal-select-none').addEventListener('click', () => {
  selected.clear();
  saveSelection();
  syncCheckboxes();
  refreshUI();
});

// Copie dans le presse-papier
document.getElementById('copy-emails').addEventListener('click', async () => {
  const emails = selectedEmails();
  if (!emails.length) { showStatus('Aucune adresse à copier.', false); return; }
  try {
    await navigator.clipboard.writeText(emails.join(', '));
    showStatus(emails.length + ' adresse(s) copiée(s) dans le presse-papier ✅', true);
  } catch {
    const tmp = document.createElement('textarea');
    tmp.value = emails.join(', ');
    document.body.appendChild(tmp);
    tmp.select();
    document.execCommand('copy');
    tmp.remove();
    showStatus(emails.length + ' adresse(s) copiée(s) ✅', true);
  }
});

// Ouverture de Roundcube : Cci + objet + corps pré-remplis au mieux
document.getElementById('open-roundcube').addEventListener('click', async () => {
  const emails = selectedEmails();
  if (!emails.length) { showStatus('Sélectionnez au moins une adresse.', false); return; }

  const subject = subjectInput.value.trim();
  const body = bodyInput.value.trim();

  const shown = emails.slice(0, BCC_LIMIT);
  const overflow = emails.slice(BCC_LIMIT);

  // Copie systématique des adresses (secours si le pré-remplissage échoue côté Roundcube)
  try { await navigator.clipboard.writeText(emails.join(', ')); } catch { /* non bloquant */ }

  let url = ROUNDCUBE_BASE + '?_task=mail&_action=compose&_bcc=' + encodeURIComponent(shown.join(', '));
  if (subject) url += '&_subject=' + encodeURIComponent(subject);
  const bodyInUrl = body && body.length <= BODY_LIMIT;
  if (bodyInUrl) url += '&_body=' + encodeURIComponent(body);

  window.open(url, '_blank', 'noopener');

  const notes = [];
  if (overflow.length) notes.push(`${overflow.length} adresse(s) dans le presse-papier — collez-les dans « Cci »`);
  if (body && !bodyInUrl) notes.push('message trop long pour le lien — copiez-le depuis la modale');
  showStatus(
    `${emails.length} adresse(s) envoyée(s) vers Roundcube ✅` + (notes.length ? ` — ${notes.join(' ; ')}.` : ''),
    true,
  );
});

// Restauration de la sélection mémorisée (ex. retour après recherche/changement de page)
syncCheckboxes();
refreshUI();
  </script>
</Layout>
