---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import Avatar from '../../../components/ui/Avatar.astro';
import Icon from '../../../components/ui/Icon.astro';
import { getClient } from '../../../../functions/api/lib/db';
import { fullName, formatDateTime } from '../../../lib/format';

const { id } = Astro.params;
const clientId = Number(id);

if (!Number.isInteger(clientId) || clientId <= 0) {
  return new Response('ID invalide', { status: 400 });
}

const DB = Astro.locals.runtime.env.DB;
const client = await getClient(DB, clientId);

if (!client) {
  return new Response(null, { status: 404 });
}
---

<Layout title={`${fullName(client)} — Sharing Fair`}>
  <div class="max-w-5xl mx-auto space-y-6">
    <PageHeader
      title={fullName(client)}
      crumbs={[
        { label: 'Clients', href: '/clients' },
        { label: fullName(client) },
      ]}
    >
      <Button slot="actions" href={`/clients/${client.id}/modifier`} variant="outline" class="flex-1 sm:flex-none justify-center">
        <Icon name="edit" size={16} />
        Modifier
      </Button>
      <Button slot="actions" variant="danger" data-open-modal="delete-confirm" class="flex-1 sm:flex-none justify-center">
        <Icon name="trash" size={16} />
        Supprimer
      </Button>
    </PageHeader>

    <!-- Header card with avatar & contact -->
    <Card class="p-6 sm:p-8 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-brand-100/40 to-transparent rounded-full -translate-y-1/2 translate-x-1/3 pointer-events-none" aria-hidden="true"></div>

      <div class="relative flex flex-col sm:flex-row items-start gap-5">
        <Avatar firstName={client.first_name} lastName={client.last_name} size="xl" />
        <div class="flex-1 min-w-0 space-y-3">
          <h1 class="font-display text-3xl text-ink-900 tracking-tight">{fullName(client)}</h1>

          <div class="grid sm:grid-cols-2 gap-3">
            <a
              href={client.phone ? `tel:${client.phone}` : '#'}
              class={`flex items-center gap-3 p-3 rounded-xl border border-ink-200 ${client.phone ? 'bg-ink-50/50 hover:bg-brand-50/40 hover:border-brand-200 transition-all group' : 'opacity-50 pointer-events-none'}`}
            >
              <span class="w-9 h-9 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                <Icon name="phone" size={16} />
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-medium uppercase tracking-wide text-ink-500">Téléphone</span>
                <span class="block text-sm text-ink-900 truncate">{client.phone || 'Non renseigné'}</span>
              </span>
            </a>

            <a
              href={client.email ? `mailto:${client.email}` : '#'}
              class={`flex items-center gap-3 p-3 rounded-xl border border-ink-200 ${client.email ? 'bg-ink-50/50 hover:bg-accent-50/40 hover:border-accent-200 transition-all group' : 'opacity-50 pointer-events-none'}`}
            >
              <span class="w-9 h-9 rounded-lg bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                <Icon name="mail" size={16} />
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-medium uppercase tracking-wide text-ink-500">Email</span>
                <span class="block text-sm text-ink-900 truncate">{client.email || 'Non renseigné'}</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </Card>

    <!-- Metadata -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-0 text-xs text-ink-400 px-1">
      <div class="flex items-center gap-1.5">
        <Icon name="calendar" size={12} />
        <span>Créé le {formatDateTime(client.created_at)}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Icon name="calendar" size={12} />
        <span>Modifié le {formatDateTime(client.updated_at)}</span>
      </div>
    </div>
  </div>

  <!-- Delete confirmation modal -->
  <div
    id="delete-confirm"
    class="fixed inset-0 z-[1000] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="delete-title"
  >
    <div class="fixed inset-0 bg-ink-900/50 backdrop-blur-sm animate-fade-in" data-close-modal></div>
    <div class="fixed inset-0 overflow-y-auto pointer-events-none">
      <div class="flex min-h-full items-end sm:items-center justify-center p-4">
        <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 animate-scale-in pointer-events-auto">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-danger-50 text-danger-600 flex items-center justify-center shrink-0">
              <Icon name="trash" size={22} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 id="delete-title" class="font-display text-xl text-ink-900 mb-1">Supprimer ce client ?</h3>
              <p class="text-sm text-ink-600 leading-relaxed">
                Vous êtes sur le point de supprimer définitivement la fiche de <strong class="text-ink-900">{fullName(client)}</strong>. Cette action est irréversible.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 mt-6">
            <button
              type="button"
              data-close-modal
              class="flex-1 h-11 px-4 rounded-lg border border-ink-200 text-sm font-medium text-ink-700 hover:bg-ink-50 transition-colors"
            >
              Annuler
            </button>
            <form method="POST" action={`/clients/${client.id}/supprimer`} class="flex-1">
              <button
                type="submit"
                class="w-full h-11 px-4 rounded-lg bg-danger-500 text-white text-sm font-medium hover:bg-danger-600 shadow-sm hover:shadow-md transition-all"
              >
                Supprimer définitivement
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    document.addEventListener('click', (e) => {
      const opener = e.target.closest('[data-open-modal]');
      if (opener) {
        const id = opener.getAttribute('data-open-modal');
        const modal = document.getElementById(id);
        if (modal) {
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        return;
      }

      const closer = e.target.closest('[data-close-modal]');
      if (closer) {
        const modal = closer.closest('[role="dialog"]');
        if (modal) {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const open = document.querySelector('[role="dialog"]:not(.hidden)');
        if (open) {
          open.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }
    });
  })();
</script>
