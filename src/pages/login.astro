---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Field from '../components/ui/Field.astro';
import Icon from '../components/ui/Icon.astro';
import InstallButton from '../components/pwa/InstallButton.astro';
import PwaInstall from '../components/pwa/PwaInstall.astro';
import { constantTimeEqual, createSessionToken, sessionCookieName, sessionCookieMaxAge } from '../lib/auth';
import { findVolunteerForLogin } from '../lib/volunteers';

/**
 * La date de naissance fait office de mot de passe : saisie masquée, plusieurs
 * formats acceptés — JJ/MM/AAAA, JJ-MM-AAAA, JJMMAAAA ou AAAA-MM-JJ (interne).
 * Retourne la date normalisée AAAA-MM-JJ, ou null si invalide (ex. 31/02/1990).
 */
function parseBirthDate(raw: string): string | null {
  const s = raw.trim();
  let y: string, m: string, d: string;
  let match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if (match) {
    [, y, m, d] = match;
  } else {
    match =
      /^(\d{2})[/\-. ](\d{2})[/\-. ](\d{4})$/.exec(s) ?? /^(\d{2})(\d{2})(\d{4})$/.exec(s);
    if (!match) return null;
    [, d, m, y] = match;
  }
  const iso = `${y}-${m}-${d}`;
  const dt = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(dt.getTime()) || dt.toISOString().slice(0, 10) !== iso) return null;
  return iso;
}

const env = Astro.locals.runtime.env;
let error: string | null = null;
const nextParam = new URL(Astro.request.url).searchParams.get('next') || '/';
const safeNext = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const firstName = String(form.get('first_name') ?? '');
  const lastName = String(form.get('last_name') ?? '');
  const birthDate = parseBirthDate(String(form.get('birth_date') ?? ''));
  const remember = form.get('remember') === 'on';
  const submittedNext = String(form.get('next') ?? '/');
  const target = submittedNext.startsWith('/') && !submittedNext.startsWith('//') ? submittedNext : '/';

  let volunteer = null;
  if (firstName.trim() && lastName.trim() && birthDate) {
    volunteer = await findVolunteerForLogin(env.DB, firstName, lastName);
  }

  if (volunteer && birthDate && constantTimeEqual(volunteer.birth_date, birthDate)) {
    const token = await createSessionToken(env.AUTH_SECRET, volunteer.id);
    const cookieOptions = {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax' as const,
      ...(sessionCookieMaxAge(remember) ? { maxAge: sessionCookieMaxAge(remember)! } : {}),
    };
    Astro.cookies.set(sessionCookieName(), token, cookieOptions);
    return Astro.redirect(target, 302);
  }
  error = 'Identifiants incorrects. Vérifiez votre prénom, votre nom et votre date de naissance.';
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#C65D3A" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <!-- PWA : installation sur l'écran d'accueil (Android & iOS) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sharing Fair" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap" />
    <title>Connexion · Sharing Fair</title>
  </head>
  <body class="min-h-screen relative overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-brand-200/30 rounded-full blur-3xl -translate-x-1/3 -translate-y-1/3"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-accent-200/30 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
      <div class="absolute top-1/2 left-1/2 w-[400px] h-[400px] bg-brand-100/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    </div>

    <div class="min-h-screen flex items-center justify-center px-4 py-10">
      <div class="w-full max-w-md animate-fade-in">
        <div class="text-center mb-8 animate-slide-up">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full overflow-hidden shadow-lg ring-1 ring-brand-300/40 mb-4 animate-scale-in bg-white">
            <img src="/logo.svg" alt="Logo La boutique solidaire" width="64" height="64" class="w-full h-full object-contain" />
          </div>
          <h1 class="font-display text-5xl text-ink-900 mb-1 tracking-tight">Sharing Fair</h1>
          <p class="text-sm text-ink-500 font-display italic">La boutique solidaire</p>
        </div>

        <form
          method="POST"
          class={`surface p-6 sm:p-8 space-y-5 ${error ? 'animate-shake' : 'animate-slide-up'}`}
          style={error ? '' : 'animation-delay: 0.1s'}
        >
          <input type="hidden" name="next" value={safeNext} />

          <Field label="Prénom" required for="first_name">
            <Input
              id="first_name"
              name="first_name"
              type="text"
              required
              autocomplete="given-name"
              placeholder="Ex. Élise"
            />
          </Field>

          <Field label="Nom" required for="last_name">
            <Input
              id="last_name"
              name="last_name"
              type="text"
              required
              autocomplete="family-name"
              placeholder="Ex. Rousseau"
            />
          </Field>

          <Field label="Date de naissance" required for="birth_date">
            <div class="relative">
              <Input
                id="birth_date"
                name="birth_date"
                type="password"
                required
                autocomplete="off"
                inputmode="numeric"
                maxlength={10}
                placeholder="JJ / MM / AAAA"
                hasError={error !== null}
                class="pr-10 tracking-wider"
              />
              <button
                type="button"
                id="toggle-birth"
                class="absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-7 h-7 rounded-md text-ink-400 hover:text-ink-700 hover:bg-ink-100 transition-colors"
                aria-label="Afficher ou masquer la date de naissance"
              >
                <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="eye-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.2 13.2 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="M2 2l20 20"/></svg>
              </button>
            </div>
            <p class="text-xs text-ink-400 mt-1.5">
              Votre date de naissance fait office de mot de passe — saisie masquée.
            </p>
          </Field>

          <label class="flex items-center gap-2.5 cursor-pointer select-none min-h-[44px] -mx-1 px-1 rounded-lg hover:bg-ink-50 transition-colors">
            <input
              type="checkbox"
              name="remember"
              checked
              class="w-4 h-4 rounded border-ink-300 text-brand-600 accent-brand-600 focus:ring-brand-500"
            />
            <span class="text-sm text-ink-700">Rester connecté sur cet appareil</span>
          </label>

          {error && (
            <p class="text-sm text-danger-700 bg-danger-50 border border-danger-200 rounded-lg px-3 py-2.5 flex items-start gap-2">
              <Icon name="info" size={16} class="mt-0.5 shrink-0" />
              <span>{error}</span>
            </p>
          )}

          <Button type="submit" variant="primary" fullWidth size="lg">
            Se connecter
            <Icon name="arrow-right" size={16} />
          </Button>
        </form>

        <!-- Installation PWA (visible uniquement si le navigateur le permet) -->
        <div class="mt-4 animate-slide-up" style="animation-delay: 0.2s">
          <InstallButton variant="login" />
        </div>
      </div>
    </div>

    <PwaInstall />

    <script is:inline>
      requestAnimationFrame(() => {
        const input = document.getElementById('first_name');
        if (input) input.focus();
      });

      // Œil : afficher/masquer la date de naissance (sa saisie est masquée).
      (() => {
        const btn = document.getElementById('toggle-birth');
        const field = document.getElementById('birth_date');
        const eyeOpen = document.getElementById('eye-open');
        const eyeClosed = document.getElementById('eye-closed');
        if (!btn || !field || !eyeOpen || !eyeClosed) return;
        btn.addEventListener('click', () => {
          const showing = field.type === 'text';
          field.type = showing ? 'password' : 'text';
          eyeOpen.classList.toggle('hidden', !showing);
          eyeClosed.classList.toggle('hidden', showing);
          field.focus();
        });
      })();

      // Saisie guidée JJ/MM/AAAA : ajoute les '/' automatiquement.
      (() => {
        const field = document.getElementById('birth_date');
        if (!field) return;
        field.addEventListener('input', () => {
          const digits = field.value.replace(/\D/g, '').slice(0, 8);
          const parts = [digits.slice(0, 2), digits.slice(2, 4), digits.slice(4, 8)].filter(Boolean);
          const formatted = parts.join('/');
          if (formatted !== field.value) field.value = formatted;
        });
      })();
    </script>
  </body>
</html>
