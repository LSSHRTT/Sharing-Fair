---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Avatar from '../components/ui/Avatar.astro';
import Icon from '../components/ui/Icon.astro';
import { countClients, recentClients } from '../../functions/api/lib/db';
import { fullName, formatRelative } from '../lib/format';
import ToastAnimated from '../components/ui/ToastAnimated.astro';

const DB = Astro.locals.runtime.env.DB;

const [total, recent] = await Promise.all([
  countClients(DB),
  recentClients(DB, 6),
]);

const hour = new Date().getHours();
const greeting = hour < 5 ? 'Bonne nuit' : hour < 12 ? 'Bonjour' : hour < 18 ? 'Bon après-midi' : 'Bonsoir';
const me = Astro.locals.volunteer;
const accessDenied = Astro.url.searchParams.get('err') === 'acces';
---

<Layout title="Sharing Fair — Tableau de bord">
  {accessDenied && (
    <ToastAnimated type="info" message="Cette section nécessite une autorisation du gérant. Demandez-lui l'accès si besoin." />
  )}

  <div class="space-y-8 sm:space-y-10">
    <!-- Hero -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-500 via-brand-600 to-brand-700 text-white p-5 sm:p-10 shadow-lg">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-brand-900/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4" aria-hidden="true"></div>

      <div class="relative max-w-3xl">
        <p class="text-sm font-display italic text-brand-100 mb-1.5">
          {greeting}{me ? `, ${me.first_name}` : ''} 👋
        </p>
        <h1 class="font-display text-3xl sm:text-5xl tracking-tight mb-2 sm:mb-3">Sharing Fair</h1>
        <p class="text-brand-50/90 text-sm sm:text-lg leading-relaxed mb-5 sm:mb-6 max-w-xl">
          Votre espace dédié à la gestion des clients de la boutique solidaire.
        </p>
        <div class="grid grid-cols-1 sm:flex sm:flex-wrap gap-2.5 sm:gap-3">
          <a
            href="/clients/nouveau"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg bg-white text-brand-700 text-sm font-semibold shadow-md hover:shadow-lg hover:-translate-y-px transition-all"
          >
            <Icon name="plus" size={16} />
            Nouveau client
          </a>
          <a
            href="/calendrier"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium hover:bg-white/20 transition-all active:bg-white/25"
          >
            <Icon name="calendar" size={16} />
            Calendrier de l'équipe
          </a>
          <a
            href="/clients"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium hover:bg-white/20 transition-all active:bg-white/25"
          >
            <Icon name="users" size={16} />
            Voir tous les clients
          </a>
        </div>
      </div>
    </section>

    <!-- Stats : bandeau compact 3 colonnes sur mobile -->
    <section class="grid grid-cols-3 gap-2 sm:gap-4" data-stagger>
      <Card class="p-3 sm:p-5 relative overflow-hidden surface-hover">
        <div class="hidden sm:block absolute top-0 right-0 w-32 h-32 bg-brand-100/40 rounded-full blur-2xl -translate-y-1/2 translate-x-1/3" aria-hidden="true"></div>
        <div class="relative flex items-start justify-between">
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wide text-ink-500 mb-1 sm:mb-2 truncate">Clients</p>
            <p class="font-display text-2xl sm:text-4xl text-ink-900">{total}</p>
            <p class="hidden sm:block text-xs text-ink-400 mt-1">fiche{total > 1 ? 's' : ''} au total</p>
          </div>
          <span class="hidden sm:flex w-11 h-11 rounded-xl bg-brand-100 text-brand-700 items-center justify-center shrink-0">
            <Icon name="users" size={20} />
          </span>
        </div>
      </Card>

      <Card class="p-3 sm:p-5 relative overflow-hidden surface-hover">
        <div class="hidden sm:block absolute top-0 right-0 w-32 h-32 bg-accent-100/40 rounded-full blur-2xl -translate-y-1/2 translate-x-1/3" aria-hidden="true"></div>
        <div class="relative flex items-start justify-between">
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wide text-ink-500 mb-1 sm:mb-2 truncate">Récents</p>
            <p class="font-display text-2xl sm:text-4xl text-ink-900">{recent.length}</p>
            <p class="hidden sm:block text-xs text-ink-400 mt-1">derniers ajouts</p>
          </div>
          <span class="hidden sm:flex w-11 h-11 rounded-xl bg-accent-100 text-accent-700 items-center justify-center shrink-0">
            <Icon name="sparkles" size={20} />
          </span>
        </div>
      </Card>

      <Card class="p-3 sm:p-5 relative overflow-hidden surface-hover">
        <div class="hidden sm:block absolute top-0 right-0 w-32 h-32 bg-info-100/40 rounded-full blur-2xl -translate-y-1/2 translate-x-1/3" aria-hidden="true"></div>
        <div class="relative flex items-start justify-between">
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wide text-ink-500 mb-1 sm:mb-2 truncate">Version</p>
            <p class="font-display text-2xl sm:text-4xl text-ink-900">0.4</p>
            <p class="hidden sm:block text-xs text-ink-400 mt-1">Navigation mobile</p>
          </div>
          <span class="hidden sm:flex w-11 h-11 rounded-xl bg-info-100 text-info-700 items-center justify-center shrink-0">
            <Icon name="heart" size={20} />
          </span>
        </div>
      </Card>
    </section>

    <!-- Recent clients -->
    <section class="space-y-5">
      <div class="flex items-end justify-between gap-3 flex-wrap">
        <div>
          <h2 class="font-display text-2xl text-ink-900 tracking-tight">Derniers clients</h2>
          <p class="text-sm text-ink-500 mt-0.5">Les fiches créées le plus récemment.</p>
        </div>
        <a href="/clients" class="text-sm font-medium text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group">
          Voir tous
          <Icon name="arrow-right" size={14} class="group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>

      {recent.length === 0 ? (
        <EmptyState
          title="Aucun client pour l'instant"
          description="Créez votre première fiche client pour commencer."
        >
          <Icon slot="icon" name="users" size={24} />
          <Button slot="actions" href="/clients/nouveau" variant="primary">
            <Icon name="plus" size={16} />
            Créer le premier client
          </Button>
        </EmptyState>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-stagger>
          {recent.map((c) => (
            <Card href={`/clients/${c.id}`} hover padded={false} class="p-5 group">
              <div class="flex items-center gap-3">
                <Avatar firstName={c.first_name} lastName={c.last_name} size="md" />
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-lg font-medium text-ink-900 truncate group-hover:text-brand-700 transition-colors">
                    {fullName(c)}
                  </h3>
                  <p class="text-[11px] text-ink-400 mt-0.5">Ajouté {formatRelative(c.created_at)}</p>
                </div>
                <Icon name="arrow-right" size={14} class="text-ink-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all" />
              </div>
              {(c.phone || c.email) && (
                <div class="flex flex-col gap-1.5 mt-4 pt-4 border-t border-ink-100">
                  {c.phone && (
                    <div class="flex items-center gap-2 text-xs text-ink-600">
                      <Icon name="phone" size={12} class="text-ink-400" />
                      <span class="truncate">{c.phone}</span>
                    </div>
                  )}
                  {c.email && (
                    <div class="flex items-center gap-2 text-xs text-ink-600">
                      <Icon name="mail" size={12} class="text-ink-400" />
                      <span class="truncate">{c.email}</span>
                    </div>
                  )}
                </div>
              )}
            </Card>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>
