---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Avatar from '../components/ui/Avatar.astro';
import Icon from '../components/ui/Icon.astro';
import ToastAnimated from '../components/ui/ToastAnimated.astro';
import { listMessages, sendMessage } from '../lib/chat';
import { sendPushTickle } from '../lib/push';

const DB = Astro.locals.runtime.env.DB;
const me = Astro.locals.volunteer!;
const runtime = Astro.locals.runtime as { env: Record<string, string>; ctx: { waitUntil(p: Promise<unknown>): void } };

// ============================================================
// Envoi d'un message
// ============================================================
let errorKey: 'vide' | 'trop_long' | 'image_trop_lourde' | null = null;

// Conversion ArrayBuffer → base64 compatible Cloudflare Workers (pas de Buffer)
function arrayBufferToBase64(buffer: ArrayBuffer): string {
  const bytes = new Uint8Array(buffer);
  let binary = '';
  for (let i = 0; i < bytes.byteLength; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  return btoa(binary);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const content = String(form.get('content') ?? '').trim();
  const imageFile = form.get('image') as File | null;

  let imageDataUrl: string | null = null;
  if (imageFile && imageFile.size > 0) {
    if (imageFile.size > 2 * 1024 * 1024) {
      errorKey = 'image_trop_lourde';
    } else {
      const buffer = await imageFile.arrayBuffer();
      const base64 = arrayBufferToBase64(buffer);
      imageDataUrl = `data:${imageFile.type};base64,${base64}`;
    }
  }

  if (!errorKey && !content && !imageDataUrl) {
    errorKey = 'vide';
  } else if (!errorKey && content.length > 2000) {
    errorKey = 'trop_long';
  } else if (!errorKey) {
    const msg = await sendMessage(DB, me.id, content || null, imageDataUrl);
    if (msg) {
      // Notification push vers les autres bénévoles (en tâche de fond)
      if (runtime?.ctx) {
        runtime.ctx.waitUntil(
          sendPushTickle(DB, runtime.env, me.id).catch(() => {}),
        );
      }
      return Astro.redirect('/chat?ok=envoye', 303);
    }
    errorKey = 'vide';
  }
}

// ============================================================
// Chargement des messages
// ============================================================
const messages = await listMessages(DB, 100);

// --- Retours d'action ---
const ok = Astro.url.searchParams.get('ok');
const errParam = Astro.url.searchParams.get('err');
const errorMessages: Record<string, string> = {
  vide: 'Le message ne peut pas être vide.',
  trop_long: 'Le message est trop long (2000 caractères max).',
  image_trop_lourde: 'L\'image est trop lourde (2 Mo max).',
};
const error = errorMessages[errorKey ?? errParam ?? ''] ?? null;
const toast = ok === 'envoye' ? 'Message envoyé ✅' : null;

// Formatage heure relative
function formatTime(iso: string): string {
  const d = new Date(iso);
  return new Intl.DateTimeFormat('fr-FR', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Paris',
  }).format(d);
}
---

<Layout title="Chat — Sharing Fair">
  <div class="max-w-3xl mx-auto space-y-4 h-[calc(100vh-8rem)] md:h-[calc(100vh-6rem)] flex flex-col">
    <PageHeader
      title="Chat d'équipe"
      description="Discutez avec les autres bénévoles de l'équipe."
    />

    {toast && <ToastAnimated type="success" message={toast} />}
    {error && <ToastAnimated type="danger" message={error} />}

    <!-- Zone des messages -->
    <section class="surface flex-1 overflow-y-auto p-4 space-y-4 animate-slide-up scroll-smooth" id="chat-messages">
      {messages.length === 0 ? (
        <p class="text-sm text-ink-400 text-center py-8">
          Aucun message pour le moment. Soyez le premier à écrire !
        </p>
      ) : (
        messages.map((msg) => {
          const isMe = msg.sender_id === me.id;
          return (
            <div class={`flex gap-3 ${isMe ? 'flex-row-reverse' : ''}`}>
              <Avatar firstName={msg.first_name} lastName={msg.last_name} src={msg.photo} size="sm" class="shrink-0 mt-1" />
              <div class={`max-w-[75%] ${isMe ? 'items-end' : 'items-start'} flex flex-col`}>
                {!isMe && (
                  <span class="text-[11px] font-medium text-ink-500 mb-0.5 ml-1">
                    {msg.first_name} {msg.last_name}
                  </span>
                )}
                <div
                  class={`px-4 py-2.5 rounded-2xl text-sm leading-relaxed break-words ${
                    isMe
                      ? 'bg-brand-600 text-white rounded-tr-md'
                      : 'bg-ink-100 text-ink-900 rounded-tl-md'
                  }`}
                >
                  {msg.image && (
                    <img src={msg.image} alt="" class="max-w-full max-h-[300px] rounded-lg mb-2 block" loading="lazy" />
                  )}
                  {msg.content}
                </div>
                <span class={`text-[10px] text-ink-400 mt-0.5 ${isMe ? 'mr-1' : 'ml-1'}`}>
                  {formatTime(msg.created_at)}
                </span>
              </div>
            </div>
          );
        })
      )}
    </section>

    <!-- Formulaire d'envoi -->
    <form method="POST" enctype="multipart/form-data" class="surface p-3 sm:p-4 animate-slide-up shrink-0" style="animation-delay: 0.08s">
      <!-- Prévisualisation image au-dessus du champ texte -->
      <div id="chat-img-preview-bar" class="hidden mb-2 relative inline-block" style="display:none">
        <img id="chat-img-preview" class="max-h-[120px] rounded-lg border border-ink-200 block" alt="" />
        <button type="button" id="chat-img-remove" class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-ink-900 text-white flex items-center justify-center text-xs hover:bg-danger-600 transition-colors" aria-label="Retirer l'image">
          <Icon name="x" size={12} />
        </button>
      </div>

      <div class="flex items-end gap-2">
        <label class="inline-flex items-center justify-center w-11 h-11 rounded-xl text-ink-500 hover:text-brand-600 hover:bg-brand-50 active:scale-[0.95] transition-all shrink-0 cursor-pointer" title="Ajouter une photo">
          <Icon name="image" size={20} />
          <input type="file" name="image" accept="image/*" class="hidden" id="chat-img-input" />
        </label>
        <div class="flex-1">
          <textarea
            name="content"
            maxlength="2000"
            rows="1"
            placeholder="Écrivez un message…"
            class="w-full px-4 py-2.5 rounded-xl border border-ink-200 bg-white text-sm text-ink-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none min-h-[44px] max-h-[120px]"
            oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,120)+'px'"
          />
        </div>
        <button
          type="submit"
          class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-brand-600 text-white hover:bg-brand-700 active:scale-[0.95] transition-all shrink-0"
          aria-label="Envoyer"
        >
          <Icon name="send" size={18} />
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    // Auto-scroll vers le bas au chargement
    const chatEl = document.getElementById('chat-messages');
    if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;

    // Prévisualisation image au-dessus du champ texte
    const imgInput = document.getElementById('chat-img-input');
    const previewBar = document.getElementById('chat-img-preview-bar');
    const imgPreview = document.getElementById('chat-img-preview');
    const removeBtn = document.getElementById('chat-img-remove');

    function clearImage() {
      if (imgInput) imgInput.value = '';
      if (imgPreview) { imgPreview.src = ''; imgPreview.removeAttribute('src'); }
      if (previewBar) { previewBar.classList.add('hidden'); previewBar.style.display = 'none'; }
    }

    if (imgInput && previewBar && imgPreview && removeBtn) {
      imgInput.addEventListener('change', () => {
        const file = imgInput.files?.[0];
        if (file && file.type.startsWith('image/')) {
          const url = URL.createObjectURL(file);
          imgPreview.src = url;
          previewBar.classList.remove('hidden');
          previewBar.style.display = 'inline-block';
        } else {
          clearImage();
        }
      });

      removeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        clearImage();
      });
    }
  </script>
</Layout>