---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Avatar from '../../components/ui/Avatar.astro';
import Badge from '../../components/ui/Badge.astro';
import Icon from '../../components/ui/Icon.astro';
import ToastAnimated from '../../components/ui/ToastAnimated.astro';
import {
  listVolunteers,
  listPresencesBetween,
  setPresence,
  clearPresence,
  isPresenceStatus,
  type PresenceStatus,
} from '../../lib/volunteers';

// ============================================================
// Paramètre de route : date ISO YYYY-MM-DD (recalée au mois sinon)
// ============================================================
const dateParam = Astro.params.date ?? '';
const parsedDate = new Date(`${dateParam}T00:00:00Z`);
const dateValid =
  /^\d{4}-\d{2}-\d{2}$/.test(dateParam) &&
  !Number.isNaN(parsedDate.getTime()) &&
  parsedDate.toISOString().slice(0, 10) === dateParam;

if (!dateValid) {
  return Astro.redirect('/calendrier', 302);
}

const DB = Astro.locals.runtime.env.DB;
const me = Astro.locals.volunteer!;

// Mois de retour (conservé à travers la navigation jour ↔ mois).
const mParam = /^\d{4}-\d{2}$/.test(Astro.url.searchParams.get('m') ?? '')
  ? Astro.url.searchParams.get('m')!
  : dateParam.slice(0, 7);

// ============================================================
// Déclaration / retrait de SA présence (chacun gère la sienne)
// ============================================================
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const back = `/calendrier/${dateParam}?m=${mParam}`;

  if (action === 'clear') {
    await clearPresence(DB, me.id, dateParam);
    return Astro.redirect(`${back}&ok=efface`, 303);
  }

  const status = String(form.get('status') ?? '');
  if (!isPresenceStatus(status)) {
    return new Response('Requête invalide', { status: 400 });
  }
  await setPresence(DB, me.id, dateParam, status);
  return Astro.redirect(`${back}&ok=${status}`, 303);
}

// ============================================================
// Données du jour : toute l'équipe + statuts déclarés
// ============================================================
const [volunteers, rows] = await Promise.all([
  listVolunteers(DB),
  listPresencesBetween(DB, dateParam, dateParam),
]);
const statusByVolunteer = new Map(rows.map((r) => [r.volunteer_id, r.status]));

const groups: Record<PresenceStatus | 'none', typeof volunteers> = {
  present: [],
  maybe: [],
  absent: [],
  none: [],
};
for (const v of volunteers) {
  groups[statusByVolunteer.get(v.id) ?? 'none'].push(v);
}

const myStatus = statusByVolunteer.get(me.id) ?? null;

const dateLabelRaw = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(parsedDate);
const dateLabel = dateLabelRaw.charAt(0).toUpperCase() + dateLabelRaw.slice(1);

// --- Toast de confirmation après enregistrement ---
const ok = Astro.url.searchParams.get('ok');
const toastMessages: Record<string, string> = {
  present: 'Présence enregistrée : vous serez là ✅',
  maybe: 'Réponse enregistrée : peut-être 🤔',
  absent: 'Absence enregistrée. Merci d\'avoir prévenu !',
  efface: 'Votre réponse a été retirée.',
};
const toast = ok ? toastMessages[ok] : null;

const GROUP_META: { key: PresenceStatus | 'none'; label: string; badge: 'success' | 'warning' | 'danger' | 'neutral' }[] = [
  { key: 'present', label: 'Présents', badge: 'success' },
  { key: 'maybe', label: 'Peut-être', badge: 'warning' },
  { key: 'absent', label: 'Absents', badge: 'danger' },
  { key: 'none', label: 'Sans réponse', badge: 'neutral' },
];

const MY_BTN: { status: PresenceStatus; label: string; icon: 'check' | 'info' | 'x'; activeClass: string }[] = [
  { status: 'present', label: 'Présent', icon: 'check', activeClass: 'bg-success-500 border-success-500 text-white shadow-md' },
  { status: 'maybe', label: 'Peut-être', icon: 'info', activeClass: 'bg-warning-500 border-warning-500 text-white shadow-md' },
  { status: 'absent', label: 'Absent', icon: 'x', activeClass: 'bg-danger-500 border-danger-500 text-white shadow-md' },
];
---

<Layout title={`${dateLabel} — Calendrier — Sharing Fair`}>
  <div class="max-w-3xl mx-auto space-y-6">
    <PageHeader
      title={dateLabel}
      crumbs={[
        { label: 'Calendrier', href: `/calendrier?m=${mParam}` },
        { label: dateLabel },
      ]}
    />

    {toast && <ToastAnimated type="success" message={toast} />}

    <!-- Ma présence -->
    <section class="surface p-5 sm:p-6 animate-slide-up">
      <div class="flex items-center gap-3 mb-4">
        <Avatar firstName={me.first_name} lastName={me.last_name} size="md" />
        <div>
          <h2 class="text-base font-semibold text-ink-900">Ma présence</h2>
          <p class="text-sm text-ink-500">
            {myStatus
              ? `Vous avez répondu « ${myStatus === 'present' ? 'Présent' : myStatus === 'maybe' ? 'Peut-être' : 'Absent'} » — vous pouvez changer à tout moment.`
              : 'Vous n\'avez pas encore répondu pour cette journée.'}
          </p>
        </div>
      </div>

      <form method="POST" class="grid grid-cols-3 gap-2">
        {MY_BTN.map((b) => (
          <button
            type="submit"
            name="status"
            value={b.status}
            class={`inline-flex items-center justify-center gap-1.5 h-11 px-2 rounded-lg border text-sm font-medium transition-all active:scale-[0.97] ${
              myStatus === b.status
                ? b.activeClass
                : 'bg-white border-ink-200 text-ink-700 hover:bg-ink-50 hover:border-ink-300'
            }`}
          >
            <Icon name={b.icon} size={16} />
            {b.label}
          </button>
        ))}
      </form>

      {myStatus && (
        <form method="POST" class="mt-3">
          <button
            type="submit"
            name="action"
            value="clear"
            class="text-xs font-medium text-ink-400 hover:text-danger-600 underline underline-offset-2 transition-colors"
          >
            Retirer ma réponse
          </button>
        </form>
      )}
    </section>

    <!-- L'équipe ce jour -->
    <section class="space-y-5 animate-slide-up" style="animation-delay: 0.08s">
      {GROUP_META.map((g) => (
        <div class="surface overflow-hidden">
          <div class="flex items-center gap-2 px-4 sm:px-5 py-3 border-b border-ink-100 bg-ink-50/50">
            <Badge variant={g.badge}>{groups[g.key].length}</Badge>
            <h3 class="text-sm font-semibold text-ink-800">{g.label}</h3>
          </div>
          {groups[g.key].length === 0 ? (
            <p class="px-4 sm:px-5 py-4 text-sm text-ink-400">Personne dans cette catégorie.</p>
          ) : (
            <ul class="divide-y divide-ink-100">
              {groups[g.key].map((v) => {
                const isMe = v.id === me.id;
                return (
                  <li class={`flex items-center gap-3 px-4 sm:px-5 py-2.5 ${isMe ? 'bg-brand-50/60' : ''}`}>
                    <Avatar firstName={v.first_name} lastName={v.last_name} size="sm" />
                    <span class="text-sm font-medium text-ink-900">
                      {v.first_name} {v.last_name}
                      {isMe && <span class="text-ink-400 font-normal"> (vous)</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      ))}
    </section>

    <p class="text-xs text-ink-400 text-center">
      Chaque bénévole déclare sa propre présence ; tout le monde voit celle des autres.
    </p>
  </div>
</Layout>
