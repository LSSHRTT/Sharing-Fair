---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import { listPresencesBetween, type PresenceStatus, type PresenceWithName } from '../../lib/volunteers';
import { listEventsBetween, eachCoveredDay, isMultiDay, type CalendarEvent } from '../../lib/events';

const DB = Astro.locals.runtime.env.DB;

// ============================================================
// Mois affiché : ?m=YYYY-MM (défaut : mois courant, heure de Paris)
// ============================================================
function parisTodayParts(): { y: number; m: number; d: number; iso: string } {
  const fmt = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Paris',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  const p = Object.fromEntries(fmt.formatToParts(new Date()).map((x) => [x.type, x.value]));
  return { y: Number(p.year), m: Number(p.month), d: Number(p.day), iso: `${p.year}-${p.month}-${p.day}` };
}

const today = parisTodayParts();

const mParam = Astro.url.searchParams.get('m') ?? '';
const mMatch = /^(\d{4})-(\d{2})$/.exec(mParam);
const monthValid = mMatch && Number(mMatch[2]) >= 1 && Number(mMatch[2]) <= 12;
const year = monthValid ? Number(mMatch[1]) : today.y;
const month = monthValid ? Number(mMatch[2]) : today.m; // 1..12
const currentParam = `${year}-${String(month).padStart(2, '0')}`;

// ============================================================
// Grille de 6 semaines × 7 jours (vue bureau), semaine = lundi
// ============================================================
const m0 = month - 1;
const firstDow = (new Date(Date.UTC(year, m0, 1)).getUTCDay() + 6) % 7;
const gridStart = new Date(Date.UTC(year, m0, 1 - firstDow));

interface Cell {
  iso: string;
  day: number;
  inMonth: boolean;
  dow: number; // 0 = lundi
}
const cells: Cell[] = Array.from({ length: 42 }, (_, i) => {
  const d = new Date(gridStart.getTime() + i * 86400000);
  return {
    iso: d.toISOString().slice(0, 10),
    day: d.getUTCDate(),
    inMonth: d.getUTCMonth() === m0,
    dow: (d.getUTCDay() + 6) % 7,
  };
});
const monthDays = cells.filter((c) => c.inMonth); // pour la vue liste (mobile)

// ============================================================
// Données : présences + événements sur la plage visible
// ============================================================
const rangeStart = cells[0].iso;
const rangeEnd = cells[41].iso;

const [presenceRows, eventRows] = await Promise.all([
  listPresencesBetween(DB, rangeStart, rangeEnd),
  listEventsBetween(DB, rangeStart, rangeEnd),
]);

const byDate = new Map<string, PresenceWithName[]>();
for (const r of presenceRows) {
  const list = byDate.get(r.date);
  if (list) list.push(r);
  else byDate.set(r.date, [r]);
}
const statusOrder: Record<PresenceStatus, number> = { present: 0, maybe: 1, absent: 2 };
for (const list of byDate.values()) {
  list.sort((a, b) => statusOrder[a.status] - statusOrder[b.status]);
}

const eventsByDate = new Map<string, CalendarEvent[]>();
for (const e of eventRows) {
  for (const day of eachCoveredDay(e.start_date, e.end_date, rangeStart, rangeEnd)) {
    const list = eventsByDate.get(day);
    if (list) list.push(e);
    else eventsByDate.set(day, [e]);
  }
}

// ============================================================
// Libellés & navigation
// ============================================================
const monthLabel = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(Date.UTC(year, m0, 1)));

const toParam = (d: Date) => `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
const prevParam = toParam(new Date(Date.UTC(year, m0 - 1, 1)));
const nextParam = toParam(new Date(Date.UTC(year, m0 + 1, 1)));
const todayParam = `${today.y}-${String(today.m).padStart(2, '0')}`;

const WEEKDAYS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];

const STATUS_LABEL: Record<PresenceStatus, string> = {
  present: 'Présent',
  maybe: 'Peut-être',
  absent: 'Absent',
};
const STATUS_CHIP: Record<PresenceStatus, string> = {
  present: 'bg-success-50 text-success-700 ring-success-100',
  maybe: 'bg-warning-50 text-warning-700 ring-warning-100',
  absent: 'bg-danger-50 text-danger-700 ring-danger-100',
};
const STATUS_DOT: Record<PresenceStatus, string> = {
  present: 'bg-success-500',
  maybe: 'bg-warning-500',
  absent: 'bg-danger-500',
};
const EVENT_CHIP = 'bg-brand-100 text-brand-800 ring-brand-200';

const MAX_ROWS = 3;  // lignes (événements + présences) max par cellule (bureau)
const MAX_DOTS = 6;  // points colorés max par cellule
---

<Layout title="Calendrier — Sharing Fair">
  <div class="space-y-5">
    <PageHeader
      title="Calendrier"
      description="Ventes de l'équipe et présences en boutique. Touchez un jour pour voir le détail et déclarer votre présence."
    >
      <a
        slot="actions"
        href="/calendrier/evenement/nouveau"
        class="inline-flex items-center gap-1.5 h-10 sm:h-9 px-3.5 rounded-lg border border-ink-200 bg-white text-sm font-medium text-ink-700 shadow-xs hover:bg-ink-50 hover:border-ink-300 transition-all"
      >
        <Icon name="plus" size={16} class="text-brand-600" />
        <span class="hidden sm:inline">Événement</span>
      </a>
      <a
        slot="actions"
        href={`/calendrier/${today.iso}?m=${currentParam}`}
        class="inline-flex items-center gap-1.5 h-10 sm:h-9 px-3.5 rounded-lg bg-brand-500 text-white text-sm font-medium shadow-sm hover:bg-brand-600 transition-all"
      >
        <Icon name="check" size={16} />
        Ma présence aujourd'hui
      </a>
    </PageHeader>

    <!-- Barre de navigation du mois — sticky : reste visible au défilement -->
    <div class="sticky top-16 z-10 surface flex items-center justify-between gap-2 px-3 sm:px-5 py-2.5 sm:py-3.5 bg-white/95 backdrop-blur-md animate-fade-in">
      <h2 class="font-display text-xl sm:text-2xl font-semibold text-ink-900 tracking-tight capitalize">
        {monthLabel}
      </h2>
      <div class="flex items-center gap-1">
        <a
          href={`/calendrier?m=${prevParam}`}
          class="inline-flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 rounded-lg text-ink-600 hover:bg-ink-100 hover:text-ink-900 transition-colors"
          aria-label="Mois précédent"
        >
          <Icon name="arrow-left" size={18} />
        </a>
        <a
          href={`/calendrier?m=${todayParam}`}
          class="inline-flex items-center h-10 sm:h-9 px-3 rounded-lg text-sm font-medium text-ink-700 hover:bg-ink-100 transition-colors"
        >
          Aujourd'hui
        </a>
        <a
          href={`/calendrier?m=${nextParam}`}
          class="inline-flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 rounded-lg text-ink-600 hover:bg-ink-100 hover:text-ink-900 transition-colors"
          aria-label="Mois suivant"
        >
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>

    <div class="surface overflow-hidden animate-fade-in" style="animation-delay: 0.05s">

      {/* ============ VUE MOBILE : liste des jours du mois ============ */}
      <div class="sm:hidden divide-y divide-ink-100">
        {monthDays.map((cell) => {
          const evts = eventsByDate.get(cell.iso) ?? [];
          const presences = byDate.get(cell.iso) ?? [];
          const isToday = cell.iso === today.iso;
          const empty = evts.length === 0 && presences.length === 0;
          return (
            <a
              href={`/calendrier/${cell.iso}?m=${currentParam}`}
              class={`flex gap-3 px-3 py-2.5 min-h-[52px] transition-colors active:bg-brand-50/70 ${isToday ? 'bg-brand-50/50' : ''}`}
            >
              <div class="flex flex-col items-center w-9 shrink-0 pt-0.5">
                <span
                  class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-sm ${
                    isToday ? 'bg-brand-500 text-white font-semibold shadow-sm' : 'text-ink-800 font-medium'
                  }`}
                >
                  {cell.day}
                </span>
                <span class="text-[10px] font-medium uppercase tracking-wide text-ink-400 mt-0.5">
                  {WEEKDAYS[cell.dow]}
                </span>
              </div>
              <div class="flex-1 min-w-0 flex flex-col gap-1 justify-center py-0.5">
                {evts.map((e) => (
                  <span class={`flex items-center gap-1.5 px-2 py-1 rounded-md text-xs font-semibold ring-1 ring-inset ${EVENT_CHIP}`}>
                    <Icon name="calendar" size={12} class="shrink-0" />
                    <span class="truncate">
                      {e.title}
                      {isMultiDay(e) && ` (jusqu'au ${e.end_date.slice(8)})`}
                      {e.hours ? ` · ${e.hours}` : ''}
                    </span>
                  </span>
                ))}
                {presences.length > 0 && (
                  <span class="flex flex-wrap gap-1">
                    {presences.map((p) => (
                      <span
                        class={`px-1.5 py-0.5 rounded-md text-[11px] font-medium ring-1 ring-inset ${STATUS_CHIP[p.status]}`}
                      >
                        {p.first_name}
                      </span>
                    ))}
                  </span>
                )}
                {empty && <span class="text-xs text-ink-300 pl-2">—</span>}
              </div>
              <Icon name="chevron-right" size={14} class="self-center text-ink-300 shrink-0" />
            </a>
          );
        })}
      </div>

      {/* ============ VUE BUREAU : grille 7 colonnes ============ */}
      <div class="hidden sm:block">
        <!-- En-têtes des jours -->
        <div class="grid grid-cols-7 border-b border-ink-200/80 bg-ink-50/60">
          {WEEKDAYS.map((d) => (
            <div class="px-1 py-2 text-center text-[11px] font-semibold uppercase tracking-wider text-ink-500">
              {d}
            </div>
          ))}
        </div>

        <div class="grid grid-cols-7">
          {cells.map((cell, i) => {
            const evts = eventsByDate.get(cell.iso) ?? [];
            const presences = byDate.get(cell.iso) ?? [];
            const isToday = cell.iso === today.iso;
            const isLastCol = i % 7 === 6;
            const shownEvents = evts.slice(0, MAX_ROWS);
            const shownPresences = presences.slice(0, Math.max(0, MAX_ROWS - shownEvents.length));
            const overflow = (evts.length - shownEvents.length) + (presences.length - shownPresences.length);
            return (
              <a
                href={`/calendrier/${cell.iso}?m=${currentParam}`}
                class={[
                  'group relative min-h-[104px] p-1.5 sm:p-2 flex flex-col gap-1 transition-colors border-b border-ink-100',
                  isLastCol ? '' : 'border-r',
                  cell.inMonth ? 'bg-white hover:bg-brand-50/50' : 'bg-ink-50/40 hover:bg-ink-100/40',
                ].join(' ')}
              >
                <span class="flex items-center justify-center">
                  <span
                    class={[
                      'inline-flex items-center justify-center w-7 h-7 rounded-full text-sm font-medium',
                      isToday
                        ? 'bg-brand-500 text-white shadow-sm font-semibold'
                        : cell.inMonth
                          ? 'text-ink-800 group-hover:text-brand-700'
                          : 'text-ink-300',
                    ].join(' ')}
                  >
                    {cell.day}
                  </span>
                </span>

                <span class="flex flex-col gap-0.5">
                  {shownEvents.map((e) => (
                    <span
                      title={`${e.title}${isMultiDay(e) ? ` (du ${e.start_date} au ${e.end_date})` : ''}${e.hours ? ` — ${e.hours}` : ''}`}
                      class={`flex items-center gap-1 truncate px-1.5 py-0.5 rounded-md text-[10px] font-semibold ring-1 ring-inset ${EVENT_CHIP}`}
                    >
                      <Icon name="calendar" size={10} class="shrink-0" />
                      <span class="truncate">{e.title}</span>
                    </span>
                  ))}
                  {shownPresences.map((p) => (
                    <span
                      title={`${p.first_name} ${p.last_name} — ${STATUS_LABEL[p.status]}`}
                      class={`truncate px-1.5 py-0.5 rounded-md text-[10px] font-medium ring-1 ring-inset ${STATUS_CHIP[p.status]}`}
                    >
                      {p.first_name}
                    </span>
                  ))}
                  {overflow > 0 && (
                    <span class="px-1.5 text-[10px] font-medium text-ink-400">+{overflow}</span>
                  )}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Légende -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 px-1 text-xs text-ink-500">
      <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md ring-1 ring-inset font-semibold ${EVENT_CHIP}`}>
        <Icon name="calendar" size={12} />
        Vente / événement
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class={`w-2.5 h-2.5 rounded-full ${STATUS_DOT.present}`} aria-hidden="true" />
        Présent
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class={`w-2.5 h-2.5 rounded-full ${STATUS_DOT.maybe}`} aria-hidden="true" />
        Peut-être
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class={`w-2.5 h-2.5 rounded-full ${STATUS_DOT.absent}`} aria-hidden="true" />
        Absent
      </span>
    </div>
  </div>
</Layout>
