---
import Field from '../ui/Field.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Client } from '../../../functions/api/lib/db';

interface Props {
  client?: Partial<Client>;
  action: string;
  submitLabel: string;
  cancelHref?: string;
  fieldErrors?: Record<string, string[]> | null;
}

const {
  client = {},
  action,
  submitLabel,
  cancelHref = '/clients',
  fieldErrors = null,
} = Astro.props;

const errFor = (field: string): string | undefined =>
  fieldErrors?.[field]?.[0];
---

<form method="POST" action={action} class="space-y-6" novalidate data-client-form>
  <!-- Import depuis les contacts du téléphone (Contact Picker API, mobile uniquement) -->
  <div data-contact-import hidden>
    <div class="surface p-4 sm:p-5 flex items-start gap-3 border-brand-200 bg-brand-50/40">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-ink-800">Importer depuis mes contacts</p>
        <p class="text-xs text-ink-500 mt-0.5">
          Sélectionnez un contact de votre téléphone pour remplir automatiquement les champs.
        </p>
      </div>
      <Button type="button" variant="outline" size="md" data-contact-pick>
        <Icon name="users" size={16} />
        Choisir un contact
      </Button>
    </div>
  </div>
  <section class="surface p-5 sm:p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <Field label="Prénom" id="first_name" required error={errFor('first_name')}>
        <Input
          id="first_name"
          name="first_name"
          required
          maxlength={100}
          autocomplete="given-name"
          value={client.first_name ?? ''}
          hasError={!!errFor('first_name')}
        />
      </Field>
      <Field label="Nom" id="last_name" required error={errFor('last_name')}>
        <Input
          id="last_name"
          name="last_name"
          required
          maxlength={100}
          autocomplete="family-name"
          value={client.last_name ?? ''}
          hasError={!!errFor('last_name')}
        />
      </Field>
      <Field label="Téléphone" id="phone" error={errFor('phone')}>
        <Input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength={30}
          value={client.phone ?? ''}
          hasError={!!errFor('phone')}
        />
      </Field>
      <Field label="Email" id="email" error={errFor('email')}>
        <Input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          value={client.email ?? ''}
          hasError={!!errFor('email')}
        />
      </Field>
    </div>
  </section>

  <div class="flex items-center gap-2 flex-wrap">
    <Button type="submit" variant="primary" size="lg">
      <Icon name="check" size={16} />
      {submitLabel}
    </Button>
    <Button href={cancelHref} variant="ghost" size="lg">
      Annuler
    </Button>
  </div>
</form>

<script>
  // Import de contact via la Contact Picker API (Chrome/Edge sur Android, HTTPS requis).
  // https://developer.mozilla.org/docs/Web/API/Contact_Picker_API
  type ContactInfo = {
    name?: string[];
    email?: string[];
    tel?: string[];
  };
  interface ContactsManager {
    select(
      properties: string[],
      options?: { multiple?: boolean }
    ): Promise<ContactInfo[]>;
    getProperties(): Promise<string[]>;
  }

  const nav = navigator as Navigator & { contacts?: ContactsManager };
  const form = document.querySelector<HTMLFormElement>('[data-client-form]');
  const importBox = document.querySelector<HTMLElement>('[data-contact-import]');
  const pickBtn = document.querySelector<HTMLButtonElement>('[data-contact-pick]');

  const supported =
    !!nav.contacts &&
    typeof nav.contacts.select === 'function' &&
    'ContactsManager' in window;

  if (supported && form && importBox && pickBtn) {
    // Affiche le bloc d'import uniquement si l'appareil le supporte.
    importBox.hidden = false;

    const setField = (name: string, value: string | undefined) => {
      if (!value) return;
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el && !el.value.trim()) el.value = value;
    };

    // Découpe un nom complet en prénom / nom.
    const splitName = (full: string): { first: string; last: string } => {
      const parts = full.trim().split(/\s+/);
      if (parts.length <= 1) return { first: parts[0] ?? '', last: '' };
      return { first: parts[0], last: parts.slice(1).join(' ') };
    };

    pickBtn.addEventListener('click', async () => {
      try {
        const supportedProps = await nav.contacts!.getProperties();
        const props = ['name', 'email', 'tel'].filter((p) =>
          supportedProps.includes(p)
        );
        const contacts = await nav.contacts!.select(props, { multiple: false });
        if (!contacts.length) return;

        const c = contacts[0];
        const fullName = c.name?.[0]?.trim();
        if (fullName) {
          const { first, last } = splitName(fullName);
          setField('first_name', first);
          setField('last_name', last);
        }
        setField('phone', c.tel?.[0]);
        setField('email', c.email?.[0]);

        // Petit retour visuel : focus sur le premier champ vide restant.
        const firstEl = form.elements.namedItem('first_name') as HTMLInputElement | null;
        firstEl?.focus();
      } catch (err) {
        // L'utilisateur a annulé ou erreur : on reste silencieux.
        console.warn('Import de contact annulé ou impossible:', err);
      }
    });
  }
</script>
