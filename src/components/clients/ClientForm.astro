---
import Field from '../ui/Field.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Client } from '../../../functions/api/lib/db';

interface Props {
  client?: Partial<Client>;
  action: string;
  submitLabel: string;
  cancelHref?: string;
  fieldErrors?: Record<string, string[]> | null;
}

const {
  client = {},
  action,
  submitLabel,
  cancelHref = '/clients',
  fieldErrors = null,
} = Astro.props;

const errFor = (field: string): string | undefined =>
  fieldErrors?.[field]?.[0];
---

<form method="POST" action={action} class="space-y-6" novalidate>
  <section class="surface p-5 sm:p-6 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <Field label="Prénom" id="first_name" required error={errFor('first_name')}>
        <Input
          id="first_name"
          name="first_name"
          required
          maxlength={100}
          autocomplete="given-name"
          value={client.first_name ?? ''}
          hasError={!!errFor('first_name')}
        />
      </Field>
      <Field label="Nom" id="last_name" required error={errFor('last_name')}>
        <Input
          id="last_name"
          name="last_name"
          required
          maxlength={100}
          autocomplete="family-name"
          value={client.last_name ?? ''}
          hasError={!!errFor('last_name')}
        />
      </Field>
      <Field label="Téléphone" id="phone" error={errFor('phone')}>
        <Input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength={30}
          value={client.phone ?? ''}
          hasError={!!errFor('phone')}
        />
      </Field>
      <Field label="Email" id="email" error={errFor('email')}>
        <Input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          value={client.email ?? ''}
          hasError={!!errFor('email')}
        />
      </Field>
    </div>
  </section>

  <div class="flex items-center gap-2 flex-wrap">
    <Button type="submit" variant="primary" size="lg">
      <Icon name="check" size={16} />
      {submitLabel}
    </Button>
    <Button href={cancelHref} variant="ghost" size="lg">
      Annuler
    </Button>
  </div>
</form>
