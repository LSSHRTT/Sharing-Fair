---
import Card from '../ui/Card.astro';
import Avatar from '../ui/Avatar.astro';
import Icon from '../ui/Icon.astro';
import { fullName } from '../../lib/format';
import type { Client } from '../../../functions/api/lib/db';

interface Props {
  client: Client;
}

const { client } = Astro.props;
---

<Card href={`/clients/${client.id}`} hover padded={false} class="p-5 group relative">
  {client.email && (
    <label
      class="absolute top-3 right-3 z-10 flex items-center justify-center w-6 h-6 rounded-md border border-ink-200 bg-white/90 backdrop-blur-sm cursor-pointer shadow-xs hover:border-brand-400 hover:bg-brand-50 transition-colors has-checked:bg-brand-500 has-checked:border-brand-500 has-checked:[&_svg]:opacity-100"
      title={`Sélectionner ${fullName(client)} pour un envoi groupé`}
      data-card-checkbox-label
    >
      <input
        type="checkbox"
        class="sr-only"
        data-email-checkbox
        value={client.email}
        data-name={fullName(client)}
        aria-label={`Sélectionner ${fullName(client)}`}
      />
      <Icon name="check" size={13} class="text-white opacity-0 transition-opacity pointer-events-none" stroke-width={3} />
    </label>
  )}
  <div class="flex items-center gap-3">
    <Avatar firstName={client.first_name} lastName={client.last_name} size="md" />
    <div class="min-w-0 flex-1">
      <h3 class="font-display text-lg font-medium text-ink-900 truncate group-hover:text-brand-700 transition-colors">
        {fullName(client)}
      </h3>
      <p class="text-[11px] text-ink-400 mt-0.5">Fiche client</p>
    </div>
    <Icon name="arrow-right" size={14} class="text-ink-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all" />
  </div>

  {(client.phone || client.email) && (
    <div class="flex flex-col gap-1.5 mt-4 pt-4 border-t border-ink-100">
      {client.phone && (
        <div class="flex items-center gap-2 text-xs text-ink-600">
          <Icon name="phone" size={12} class="text-ink-400 shrink-0" />
          <span class="truncate">{client.phone}</span>
        </div>
      )}
      {client.email && (
        <div class="flex items-center gap-2 text-xs text-ink-600">
          <Icon name="mail" size={12} class="text-ink-400 shrink-0" />
          <span class="truncate">{client.email}</span>
        </div>
      )}
    </div>
  )}
</Card>

<script is:inline>
  // Empêche la navigation vers la fiche quand on clique sur la checkbox
  document.addEventListener('click', (e) => {
    const checkboxLabel = e.target.closest('[data-card-checkbox-label]');
    if (checkboxLabel) {
      e.preventDefault();
      e.stopPropagation();
      const input = checkboxLabel.querySelector('[data-email-checkbox]');
      if (input) {
        input.checked = !input.checked;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
  });
</script>
