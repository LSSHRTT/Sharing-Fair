---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="flex items-center gap-1.5 text-sm">
  {items.map((item, i) => (
    <div class="flex items-center gap-1.5">
      {i > 0 && <Icon name="chevron-right" size={14} class="text-ink-400" />}
      {item.href && i < items.length - 1 ? (
        <a href={item.href} class="text-ink-500 hover:text-ink-900 transition-colors">{item.label}</a>
      ) : (
        <span class="text-ink-900 font-medium">{item.label}</span>
      )}
    </div>
  ))}
</nav>
