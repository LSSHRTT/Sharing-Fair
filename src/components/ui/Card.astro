---
import { cn } from '../../lib/cn';

interface Props {
  as?: 'div' | 'article' | 'section' | 'a';
  href?: string;
  hover?: boolean;
  padded?: boolean;
  class?: string;
}

const { as = 'div', href, hover = false, padded = true, class: className = '' } = Astro.props;
const Tag = href ? 'a' : as;

const classes = cn(
  'surface',
  hover && 'surface-hover',
  padded && 'p-6',
  href && 'block',
  className
);
---

<Tag class={classes} href={href}>
  <slot />
</Tag>
