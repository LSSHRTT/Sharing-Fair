---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
}

const { title, description, crumbs } = Astro.props;
---

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="space-y-2 min-w-0">
    {crumbs && crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-900 text-balance">{title}</h1>
    {description && <p class="text-sm sm:text-base text-ink-600 max-w-2xl text-pretty">{description}</p>}
  </div>
  <div class="flex items-center gap-2 flex-wrap">
    <slot name="actions" />
  </div>
</div>
