---
import { cn } from '../../lib/cn';

interface Props {
  id?: string;
  name?: string;
  required?: boolean;
  disabled?: boolean;
  hasError?: boolean;
  class?: string;
}

const { hasError = false, class: className = '', ...rest } = Astro.props;

const base =
  'block w-full h-10 rounded-lg border bg-white text-sm text-ink-900 shadow-xs transition-all duration-150 focus:outline-none focus:ring-4 pl-3 pr-9 appearance-none bg-no-repeat bg-right disabled:bg-ink-50 disabled:cursor-not-allowed';
const normal = 'border-ink-200 hover:border-ink-300 focus:border-brand-500 focus:ring-brand-500/15';
const error = 'border-danger-300 focus:border-danger-500 focus:ring-danger-500/15';
---

<div class="relative">
  <select class={cn(base, hasError ? error : normal, className)} {...rest}>
    <slot />
  </select>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 pointer-events-none"
    aria-hidden="true"
  >
    <path d="m6 9 6 6 6-6" />
  </svg>
</div>
