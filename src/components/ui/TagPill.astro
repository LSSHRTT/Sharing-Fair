---
import { cn } from '../../lib/cn';

interface Props {
  tag: string;
  href?: string;
  class?: string;
}

const { tag, href, class: className = '' } = Astro.props;

const palette = [
  'bg-brand-50 text-brand-700 ring-brand-200',
  'bg-info-50 text-info-700 ring-info-200',
  'bg-success-50 text-success-700 ring-success-200',
  'bg-warning-50 text-warning-700 ring-warning-200',
  'bg-purple-50 text-purple-700 ring-purple-200',
  'bg-pink-50 text-pink-700 ring-pink-200',
  'bg-teal-50 text-teal-700 ring-teal-200',
  'bg-indigo-50 text-indigo-700 ring-indigo-200',
];

let h = 0;
for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) >>> 0;
const palClass = palette[h % palette.length];

const base = cn(
  'inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium rounded-full ring-1 ring-inset',
  palClass,
  href && 'hover:opacity-80 transition-opacity',
  className
);
---

{href ? <a href={href} class={base}>{tag}</a> : <span class={base}>{tag}</span>}
