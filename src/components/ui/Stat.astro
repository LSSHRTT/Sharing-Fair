---
import { cn } from '../../lib/cn';

interface Props {
  label: string;
  value: string | number;
  hint?: string;
  trend?: { value: string; direction: 'up' | 'down' | 'flat' };
  tone?: 'neutral' | 'brand' | 'success' | 'info';
  class?: string;
}

const { label, value, hint, trend, tone = 'neutral', class: className = '' } = Astro.props;

const tones = {
  neutral: 'text-ink-900',
  brand: 'text-brand-600',
  success: 'text-success-700',
  info: 'text-info-700',
};

const iconBg = {
  neutral: 'bg-ink-100 text-ink-600',
  brand: 'bg-brand-100 text-brand-700',
  success: 'bg-success-100 text-success-700',
  info: 'bg-info-100 text-info-700',
};
---

<div class={cn('card-feature p-5 sm:p-6 flex flex-col gap-3', className)}>
  <div class="flex items-start justify-between gap-3">
    <p class="text-sm font-medium text-ink-600">{label}</p>
    <span class={cn('flex items-center justify-center w-9 h-9 rounded-lg', iconBg[tone])}>
      <slot name="icon" />
    </span>
  </div>
  <div class="flex items-baseline gap-2 flex-wrap">
    <p class={cn('text-3xl sm:text-4xl font-bold tracking-tight tabular-nums', tones[tone])}>{value}</p>
    {trend && (
      <span class={cn(
        'text-xs font-semibold inline-flex items-center gap-0.5',
        trend.direction === 'up' && 'text-success-700',
        trend.direction === 'down' && 'text-danger-700',
        trend.direction === 'flat' && 'text-ink-500',
      )}>
        {trend.direction === 'up' && '↑'}
        {trend.direction === 'down' && '↓'}
        {trend.direction === 'flat' && '→'}
        {trend.value}
      </span>
    )}
  </div>
  {hint && <p class="text-xs text-ink-500">{hint}</p>}
</div>
