---
import { cn } from '../../lib/cn';
import { initials, avatarColorFor } from '../../lib/format';

interface Props {
  firstName: string;
  lastName: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  /** Photo de profil (data URL) — prioritaire sur les initiales si présente. */
  src?: string | null;
}

const { firstName, lastName, size = 'md', class: className = '', src = null } = Astro.props;
const ini = initials(firstName, lastName);
const { bg, text } = avatarColorFor(`${firstName}${lastName}`);

const sizes = {
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-12 h-12 text-base',
  xl: 'w-20 h-20 text-2xl',
};
---

<span
  class={cn(
    'inline-flex items-center justify-center rounded-full font-semibold ring-2 ring-white shrink-0 overflow-hidden',
    src ? '' : cn(bg, text),
    sizes[size],
    className
  )}
  aria-hidden="true"
>
  {src ? (
    <img src={src} alt="" loading="lazy" class="w-full h-full object-cover" />
  ) : (
    ini
  )}
</span>
