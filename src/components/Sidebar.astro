---
import Icon from './ui/Icon.astro';
import { cn } from '../lib/cn';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const items = [
  { href: '/', label: 'Tableau de bord', icon: 'dashboard' as const },
  { href: '/clients', label: 'Clients', icon: 'users' as const },
];
---

<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-40 w-64 bg-white/95 backdrop-blur-md border-r border-ink-200 flex-col -translate-x-full md:translate-x-0 md:flex md:relative md:inset-auto transition-transform duration-300 ease-out flex"
>
  <!-- Brand -->
  <a href="/" class="flex items-center gap-3 px-5 py-5 border-b border-ink-200/80 group">
    <span class="w-10 h-10 rounded-full overflow-hidden shadow-md ring-1 ring-brand-300/40 group-hover:shadow-lg group-hover:scale-105 transition-all duration-200">
      <img src="/logo.svg" alt="Logo La boutique solidaire" width="40" height="40" class="w-full h-full object-contain" />
    </span>
    <span class="flex flex-col leading-tight">
      <span class="font-display text-xl font-semibold text-ink-900 tracking-tight">Sharing Fair</span>
      <span class="text-[11px] text-ink-500 font-display italic">La boutique solidaire</span>
    </span>
  </a>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
    <p class="px-3 mb-2 text-[10px] font-semibold text-ink-400 uppercase tracking-[0.12em]">Navigation</p>
    {items.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={cn(
            'group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200',
            active
              ? 'bg-gradient-to-r from-brand-50 to-brand-100/50 text-brand-800 shadow-xs'
              : 'text-ink-700 hover:bg-ink-100/70 hover:text-ink-900 hover:translate-x-0.5',
          )}
        >
          {active && (
            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-1 bg-gradient-to-b from-brand-500 to-brand-600 rounded-r" aria-hidden="true" />
          )}
          <Icon name={item.icon} size={18} class={active ? 'text-brand-600' : 'text-ink-500 group-hover:text-ink-700 transition-colors'} />
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Footer -->
  <div class="px-4 py-4 border-t border-ink-200/80 flex items-center justify-between text-[11px] text-ink-400">
    <span class="font-medium">v0.1.0</span>
    <a href="/logout" class="inline-flex items-center gap-1 hover:text-brand-700 transition-colors font-medium">
      <Icon name="arrow-right" size={12} />
      Déconnexion
    </a>
  </div>
</aside>

<!-- Mobile backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-ink-900/40 backdrop-blur-sm hidden md:hidden transition-opacity duration-200"
  aria-hidden="true"
></div>

<script is:inline>
  (function () {
    const sidebar = document.getElementById('app-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggle = document.getElementById('sidebar-toggle');
    if (!sidebar || !backdrop || !toggle) return;

    const open = () => {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      sidebar.classList.add('-translate-x-full');
      sidebar.classList.remove('translate-x-0');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
    };
    const isOpen = () => !sidebar.classList.contains('-translate-x-full');

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) close();
    });
  })();
</script>
