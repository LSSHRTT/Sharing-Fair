---
import Icon from './ui/Icon.astro';
import Avatar from './ui/Avatar.astro';
import { cn } from '../lib/cn';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const volunteer = Astro.locals.volunteer;

// Onglets visibles selon les permissions du bénévole
// (le gérant voit tout — voir canAccess).
const items = [
  { href: '/', label: 'Tableau de bord', icon: 'dashboard' as const, access: null as null },
  { href: '/calendrier', label: 'Calendrier', icon: 'calendar' as const, access: 'calendrier' as const },
  { href: '/chat', label: 'Chat', icon: 'message-circle' as const, access: null as null },
  { href: '/clients', label: 'Clients', icon: 'users' as const, access: 'clients' as const },
  { href: '/equipe', label: 'Équipe', icon: 'heart' as const, access: 'equipe' as const },
].filter((i) => !i.access || !volunteer || volunteer.role === 'gerant' || volunteer[`access_${i.access}`] === 1);
---

<!-- Sidebar : ordinateur/tablette uniquement. Sur mobile, la navigation
     se fait via la barre d'onglets en bas d'écran (BottomNav). -->
<aside
  class="hidden md:flex w-64 bg-white/95 backdrop-blur-md border-r border-ink-200 flex-col md:h-screen md:sticky md:top-0 shrink-0"
>
  <!-- Brand -->
  <a href="/" class="flex items-center gap-3 px-5 py-5 border-b border-ink-200/80 group">
    <span class="w-10 h-10 rounded-full overflow-hidden shadow-md ring-1 ring-brand-300/40 group-hover:shadow-lg group-hover:scale-105 transition-all duration-200">
      <img src="/logo.svg" alt="Logo La boutique solidaire" width="40" height="40" class="w-full h-full object-contain" />
    </span>
    <span class="flex flex-col leading-tight">
      <span class="font-display text-xl font-semibold text-ink-900 tracking-tight">Sharing Fair</span>
      <span class="text-[11px] text-ink-500 font-display italic">La boutique solidaire</span>
    </span>
  </a>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
    <p class="px-3 mb-2 text-[10px] font-semibold text-ink-400 uppercase tracking-[0.12em]">Navigation</p>
    {items.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={cn(
            'group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200',
            active
              ? 'bg-gradient-to-r from-brand-50 to-brand-100/50 text-brand-800 shadow-xs'
              : 'text-ink-700 hover:bg-ink-100/70 hover:text-ink-900 hover:translate-x-0.5',
          )}
        >
          {active && (
            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-6 w-1 bg-gradient-to-b from-brand-500 to-brand-600 rounded-r" aria-hidden="true" />
          )}
          <Icon name={item.icon} size={18} class={active ? 'text-brand-600' : 'text-ink-500 group-hover:text-ink-700 transition-colors'} />
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Bénévole connecté → accès au profil -->
  {volunteer && (
    <a
      href="/profil"
      class="px-4 py-3 border-t border-ink-200/80 flex items-center gap-3 hover:bg-brand-50/60 transition-colors group"
      title="Mon profil"
    >
      <Avatar firstName={volunteer.first_name} lastName={volunteer.last_name} src={volunteer.photo} size="sm" />
      <div class="min-w-0 flex-1 leading-tight">
        <p class="text-sm font-medium text-ink-900 truncate group-hover:text-brand-800 transition-colors">{volunteer.first_name} {volunteer.last_name}</p>
        <p class="text-[11px] text-ink-400">Mon profil</p>
      </div>
      <Icon name="chevron-right" size={14} class="text-ink-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all" />
    </a>
  )}

  <!-- Footer -->
  <div class="px-4 py-4 border-t border-ink-200/80 flex items-center justify-end text-[11px] text-ink-400">
    <a href="/logout" class="inline-flex items-center gap-1 hover:text-brand-700 transition-colors font-medium">
      <Icon name="arrow-right" size={12} />
      Déconnexion
    </a>
  </div>
</aside>

