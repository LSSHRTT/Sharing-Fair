---
import Icon from './ui/Icon.astro';
import InstallButton from './pwa/InstallButton.astro';
import { countUnread } from '../lib/notifications';
import { canDo } from '../lib/volunteers';

const path = Astro.url.pathname;

let title = 'Tableau de bord';
if (path.startsWith('/clients/nouveau')) title = 'Nouveau client';
else if (/^\/clients\/\d+\/modifier/.test(path)) title = 'Modifier le client';
else if (/^\/clients\/\d+\/?$/.test(path)) title = 'Fiche client';
else if (path.startsWith('/clients')) title = 'Clients';
else if (/^\/calendrier\/\d{4}-\d{2}-\d{2}/.test(path)) title = 'Journée';
else if (path.startsWith('/calendrier/evenement')) title = 'Événement';
else if (path.startsWith('/calendrier')) title = 'Calendrier';
else if (path.startsWith('/equipe')) title = 'Équipe';
else if (path.startsWith('/profil')) title = 'Mon profil';
else if (path.startsWith('/notifications')) title = 'Notifications';

const q = Astro.url.searchParams.get('q') ?? '';

const me = Astro.locals.volunteer;
const unread = me ? await countUnread(Astro.locals.runtime.env.DB, me.id) : 0;
// Création de client : capacité « Ajouter des clients » requise.
const canCreateClient = !!me && canDo(me, 'add_clients');
---

<header class="sticky top-0 z-20 bg-white/85 backdrop-blur-md border-b border-ink-200">
  <div class="flex items-center gap-3 h-16 px-4 sm:px-6 lg:px-8">
    <!-- Mini-brand (mobile : la sidebar est masquée, la nav se fait en bas) -->
    <a href="/" class="md:hidden flex items-center gap-2 shrink-0 -ml-1">
      <img src="/logo.svg" alt="" width="30" height="30" class="w-[30px] h-[30px] rounded-full shadow-sm ring-1 ring-brand-300/40" />
    </a>

    <!-- Page title -->
    <h2 class="text-base sm:text-lg font-semibold text-ink-900 tracking-tight truncate">{title}</h2>

    <!-- Search (desktop only) -->
    <form action="/clients" method="get" class="hidden lg:flex ml-auto items-center relative w-[24rem] max-w-md">
      <Icon name="search" size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-400 pointer-events-none" />
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Rechercher un client (nom, email, téléphone…)"
        class="w-full h-9 pl-9 pr-3 rounded-lg border border-ink-200 bg-white/80 text-sm text-ink-900 placeholder-ink-400 transition-all focus:outline-none focus:border-brand-500 focus:ring-4 focus:ring-brand-500/15 focus:bg-white"
        aria-label="Rechercher"
      />
    </form>

    <!-- Right actions -->
    <div class="ml-auto lg:ml-0 flex items-center gap-2">
      <!-- Cloche de notifications -->
      <a
        href="/notifications"
        class="relative inline-flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 rounded-lg text-ink-600 hover:bg-ink-100 hover:text-ink-900 transition-colors"
        aria-label={unread > 0 ? `Notifications : ${unread} non lue${unread > 1 ? 's' : ''}` : 'Notifications'}
      >
        <Icon name="bell" size={19} />
        {unread > 0 && (
          <span class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 rounded-full bg-danger-500 text-white text-[10px] font-bold flex items-center justify-center shadow-sm ring-2 ring-white">
            {unread > 99 ? '99+' : unread}
          </span>
        )}
      </a>
      <InstallButton variant="topbar" />
      {canCreateClient && (
        <a
          href="/clients/nouveau"
          class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg bg-brand-500 text-white text-sm font-medium shadow-sm hover:bg-brand-600 hover:shadow-md transition-all"
        >
          <Icon name="plus" size={16} />
          <span class="hidden sm:inline">Nouveau client</span>
          <span class="sm:hidden">Ajouter</span>
        </a>
      )}
    </div>
  </div>
</header>
