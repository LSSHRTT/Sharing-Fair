---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import BottomNav from '../components/BottomNav.astro';
import PwaInstall from '../components/pwa/PwaInstall.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sharing Fair',
  description = 'Gestion de la boutique Sharing Fair — clients, communauté, partage.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#C65D3A" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <!-- PWA : installation sur l'écran d'accueil (Android & iOS) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sharing Fair" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap" />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <div class="min-h-screen md:flex">
      <Sidebar />
      <div class="flex-1 flex flex-col min-w-0">
        <TopBar />
        <main class="flex-1 px-4 sm:px-6 lg:px-8 pt-5 sm:pt-8 pb-6 sm:pb-8">
          <div class="container-app animate-fade-in">
            <slot />
          </div>
        </main>
        <footer class="mt-12 bg-ink-900 text-ink-300">
          <div class="container-app px-4 sm:px-6 lg:px-8 py-6 pb-24 md:pb-6 flex flex-wrap items-center justify-between gap-3 text-xs">
            <span>© {new Date().getFullYear()} Sharing Fair</span>
            <nav class="flex items-center gap-4">
              <a href="/" class="hover:text-brand-200 transition-colors">Tableau de bord</a>
              <a href="/clients" class="hover:text-brand-200 transition-colors">Clients</a>
              <a href="/logout" class="hover:text-brand-200 transition-colors">Déconnexion</a>
            </nav>
          </div>
        </footer>
      </div>
    </div>
    <BottomNav />
    <PwaInstall />
  </body>
</html>
