---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sharing Fair',
  description = 'Gestion de la boutique Sharing Fair — clients, communauté, partage.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FF6B4A" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Inter font preconnect + load -->
    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <div class="min-h-screen md:flex">
      <Sidebar />
      <div class="flex-1 flex flex-col min-w-0">
        <TopBar />
        <main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
          <div class="container-app animate-fade-in">
            <slot />
          </div>
        </main>
        <footer class="px-4 sm:px-6 lg:px-8 py-6 text-center text-xs text-ink-400">
          © {new Date().getFullYear()} Sharing Fair · Conçu avec soin
        </footer>
      </div>
    </div>
  </body>
</html>
