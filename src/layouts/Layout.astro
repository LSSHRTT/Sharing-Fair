---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sharing Fair',
  description = 'Gestion de la boutique Sharing Fair — clients, communauté, partage.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#C65D3A" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap" />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <div class="min-h-screen md:flex">
      <Sidebar />
      <div class="flex-1 flex flex-col min-w-0">
        <TopBar />
        <main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
          <div class="container-app animate-fade-in">
            <slot />
          </div>
        </main>
        <footer class="mt-12 bg-ink-900 text-ink-100">
          <div class="container-app px-4 sm:px-6 lg:px-8 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <p class="font-display text-2xl text-brand-200 mb-2">Sharing Fair</p>
              <p class="text-sm text-ink-300/80 leading-relaxed max-w-xs">
                Une boutique pensée comme un lieu de partage. Chaque fiche client compte, chaque rencontre aussi.
              </p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-300/80 mb-3">Navigation</p>
              <ul class="space-y-1.5 text-sm">
                <li><a href="/" class="text-ink-200 hover:text-brand-200 transition-colors">Tableau de bord</a></li>
                <li><a href="/clients" class="text-ink-200 hover:text-brand-200 transition-colors">Clients</a></li>
                <li><a href="/clients/nouveau" class="text-ink-200 hover:text-brand-200 transition-colors">Nouveau client</a></li>
              </ul>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-300/80 mb-3">À propos</p>
              <p class="text-sm text-ink-300/80 leading-relaxed">
                Fabriqué avec le cœur. Outil interne pour la gestion quotidienne de la boutique.
              </p>
            </div>
          </div>
          <div class="border-t border-ink-700/60">
            <div class="container-app px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-400">
              <span>© {new Date().getFullYear()} Sharing Fair · Tous droits réservés</span>
              <span class="font-display italic text-ink-300">Conçu avec soin</span>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
